{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "HANDS_FREE_HARNESS=claude-code python3 \"${CLAUDE_HOME:-$HOME/.claude}/hands-free/scripts/hands_free_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "HANDS_FREE_HARNESS=claude-code python3 \"${CLAUDE_HOME:-$HOME/.claude}/hands-free/scripts/hands_free_hook.py\"",
            "statusMessage": "Hands-free phone approval",
            "timeout": 220
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "HANDS_FREE_HARNESS=claude-code python3 \"${CLAUDE_HOME:-$HOME/.claude}/hands-free/scripts/hands_free_hook.py\"",
            "statusMessage": "Checking hands-free phone input",
            "timeout": 240
          }
        ]
      }
    ]
  }
}
