{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"${CODEX_HOME:-$HOME/.codex}/hands-free/scripts/hands_free_hook.py\" ]; then HANDS_FREE_HARNESS=codex python3 \"${CODEX_HOME:-$HOME/.codex}/hands-free/scripts/hands_free_hook.py\"; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"${CODEX_HOME:-$HOME/.codex}/hands-free/scripts/hands_free_hook.py\" ]; then HANDS_FREE_HARNESS=codex python3 \"${CODEX_HOME:-$HOME/.codex}/hands-free/scripts/hands_free_hook.py\"; fi",
            "statusMessage": "Calling for hands-free approval",
            "timeout": 220
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"${CODEX_HOME:-$HOME/.codex}/hands-free/scripts/hands_free_hook.py\" ]; then HANDS_FREE_HARNESS=codex python3 \"${CODEX_HOME:-$HOME/.codex}/hands-free/scripts/hands_free_hook.py\"; fi",
            "statusMessage": "Checking hands-free phone input",
            "timeout": 240
          }
        ]
      }
    ]
  }
}
